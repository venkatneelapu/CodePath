# ==============================================================================
# CodePath - Single Environment Configuration
# ==============================================================================
# All services (Frontend & Backend) read from this single file.
# This file is pre-configured with default working settings so you and your
# friends can clone and run the project immediately without manual configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Default local MongoDB connection string:
MONGODB_URI=mongodb://localhost:27017/codepath

# If using MongoDB Atlas (Cloud), uncomment and fill your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codepath?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Pre-configured with project Gemini API Key for instant AI roadmaps & mentor chat:
GEMINI_API_KEY=AIzaSyAeq7ppqjGI5h7Hvx_eJCfPGKHFczVCmvc
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyAeq7ppqjGI5h7Hvx_eJCfPGKHFczVCmvc

# ------------------------------------------------------------------------------
# 3. Application URLs & Ports
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
BACKEND_PORT=5000

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
SESSION_SECRET=codepath_super_secure_session_secret_key_2026_xyz987654321
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 5. Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
