# ==============================================================================
# CodePath - Single Environment Configuration
# ==============================================================================
# All services (Frontend & Backend) read from this single file.
# Copy this file to .env before starting:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Local MongoDB instance:
MONGODB_URI=mongodb://localhost:27017/codepath

# Or MongoDB Atlas (Cloud) connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codepath?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
# Required for AI Roadmap Generator, Coding Mentor, Quizzes, and Challenges.
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Application URLs & Ports
# ------------------------------------------------------------------------------
# The URL where your frontend will be accessed
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port configuration
PORT=3000
BACKEND_PORT=5000

# ------------------------------------------------------------------------------
# 4. Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
